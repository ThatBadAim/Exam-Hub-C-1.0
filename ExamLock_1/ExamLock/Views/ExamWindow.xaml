<Window x:Class="ExamLock.Views.ExamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Title="ExamLock">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Recovery banner -->
            <RowDefinition Height="40"/>    <!-- Top bar -->
            <RowDefinition Height="Auto"/>  <!-- Warning banner -->
            <RowDefinition Height="36"/>    <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Writing area -->
            <RowDefinition Height="24"/>    <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── Recovery banner ─────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#1a4a1a" Padding="12,6"
                Visibility="{Binding RecoveryBannerVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Session restored after unexpected exit."
                       Foreground="#6eff6e" FontSize="12" HorizontalAlignment="Center"/>
        </Border>

        <!-- ── Top bar ─────────────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <TextBlock Text="{Binding HeaderText}"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource SecondaryBrush}"/>

                <TextBlock Text="{Binding TimerDisplay}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{Binding TimerColor}"/>

                <Button Content="Exit Exam" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Height="28" Padding="12,4"
                        Background="{StaticResource HighlightBrush}"
                        Click="ExitExamButton_Click"/>
            </Grid>
        </Border>

        <!-- ── Warning banner ──────────────────────────────────────────── -->
        <Border Grid.Row="2" Padding="12,6"
                Visibility="{Binding WarningVisible, Converter={StaticResource BoolToVis}}">
            <Border.Background>
                <SolidColorBrush Color="{Binding WarningColor}"/>
            </Border.Background>
            <TextBlock Text="{Binding WarningText}" Foreground="#1a1a1a"
                       FontWeight="SemiBold" HorizontalAlignment="Center" FontSize="13"/>
        </Border>

        <!-- ── Toolbar ──────────────────────────────────────────────────── -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">

                <ToggleButton x:Name="BoldButton"
                              Style="{StaticResource ToolbarToggleButton}"
                              FontWeight="Bold" Content="B" Width="32"
                              Checked="BoldButton_Checked" Unchecked="BoldButton_Checked"/>

                <ToggleButton x:Name="ItalicButton"
                              Style="{StaticResource ToolbarToggleButton}"
                              FontStyle="Italic" Content="I" Width="32" Margin="2,0"
                              Checked="ItalicButton_Checked" Unchecked="ItalicButton_Checked"/>

                <ToggleButton x:Name="UnderlineButton"
                              Style="{StaticResource ToolbarToggleButton}"
                              Content="U" Width="32"
                              Checked="UnderlineButton_Checked" Unchecked="UnderlineButton_Checked">
                    <ToggleButton.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextDecorations" Value="Underline"/>
                        </Style>
                    </ToggleButton.Resources>
                </ToggleButton>

                <Separator Width="1" Background="{StaticResource FieldBorderBrush}" Margin="6,4"/>

                <ComboBox x:Name="FontCombo" Width="160" Margin="4,0"
                          SelectionChanged="FontCombo_SelectionChanged">
                    <ComboBoxItem Content="Arial" IsSelected="True"/>
                    <ComboBoxItem Content="Times New Roman"/>
                </ComboBox>

                <ComboBox x:Name="SizeCombo" Width="60" Margin="4,0"
                          SelectionChanged="SizeCombo_SelectionChanged">
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="12" IsSelected="True"/>
                    <ComboBoxItem Content="14"/>
                    <ComboBoxItem Content="16"/>
                    <ComboBoxItem Content="18"/>
                </ComboBox>

                <Separator Width="1" Background="{StaticResource FieldBorderBrush}" Margin="6,4"/>

                <ToggleButton x:Name="HighContrastButton"
                              Style="{StaticResource ToolbarToggleButton}"
                              Content="High Contrast" Margin="2,0"
                              Checked="HighContrast_Checked" Unchecked="HighContrast_Unchecked"/>

                <Button Style="{StaticResource ToolbarButton}"
                        Content="Colour Veil ▾" Margin="2,0"
                        Click="VeilButton_Click"/>

                <!-- Veil popup -->
                <Popup x:Name="VeilPopup" StaysOpen="False" Placement="Bottom">
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource FieldBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Colour Veil" FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button Style="{StaticResource ToolbarButton}"
                                        Content="None"   Tag="Transparent"   Click="VeilPreset_Click" Margin="2"/>
                                <Button Style="{StaticResource ToolbarButton}"
                                        Content="Yellow" Tag="#ffff00"        Click="VeilPreset_Click" Margin="2"
                                        Background="#cccc00"/>
                                <Button Style="{StaticResource ToolbarButton}"
                                        Content="Blue"   Tag="#4488ff"        Click="VeilPreset_Click" Margin="2"
                                        Background="#2255aa"/>
                                <Button Style="{StaticResource ToolbarButton}"
                                        Content="Green"  Tag="#44cc44"        Click="VeilPreset_Click" Margin="2"
                                        Background="#227722"/>
                                <Button Style="{StaticResource ToolbarButton}"
                                        Content="Pink"   Tag="#ff88bb"        Click="VeilPreset_Click" Margin="2"
                                        Background="#aa4466"/>
                            </WrapPanel>
                            <Button Style="{StaticResource ToolbarButton}" Content="Custom…"
                                    Margin="0,8,0,0" Click="VeilCustom_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Border>

        <!-- ── Writing area ─────────────────────────────────────────────── -->
        <Grid Grid.Row="4">
            <RichTextBox x:Name="EditorBox"
                         Background="White" Foreground="Black"
                         FontFamily="Arial" FontSize="12"
                         Padding="16" BorderThickness="0"
                         AcceptsReturn="True" AcceptsTab="True"
                         SpellCheck.IsEnabled="False"
                         ContextMenu="{x:Null}"
                         TextChanged="EditorBox_TextChanged"
                         SelectionChanged="EditorBox_SelectionChanged">
                <RichTextBox.Document>
                    <FlowDocument/>
                </RichTextBox.Document>
            </RichTextBox>

            <!-- Colour veil overlay -->
            <Rectangle x:Name="VeilOverlay"
                       IsHitTestVisible="False"
                       Opacity="0.18"/>
        </Grid>

        <!-- ── Status bar ─────────────────────────────────────────────────── -->
        <Border Grid.Row="5" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock Text="{Binding LastSavedText}"
                           VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource SecondaryBrush}"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource SecondaryBrush}">
                    <Run Text="{Binding WordCount, Mode=OneWay}"/>
                    <Run Text=" words"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ══ Exit overlay ══════════════════════════════════════════════════ -->
        <Grid Grid.RowSpan="6" Panel.ZIndex="100"
              Visibility="{Binding ExitOverlayVisible, Converter={StaticResource BoolToVis}}">
            <Rectangle Fill="#99000000"/>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                    Padding="36" Width="400" VerticalAlignment="Center"
                    BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="End Exam" FontSize="20" FontWeight="Bold"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Enter the invigilator password to exit exam mode."
                               Foreground="{StaticResource SecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,16" FontSize="12"/>

                    <Border Background="#5e1a2e" CornerRadius="6" Padding="10,7"
                            Margin="0,0,0,10"
                            Visibility="{Binding HasExitError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ExitPasswordError}"
                                   Foreground="#ff6b8a" TextWrapping="Wrap" FontSize="12"/>
                    </Border>

                    <PasswordBox x:Name="ExitPasswordBox"
                                 IsEnabled="{Binding ExitInputEnabled}"
                                 Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel"
                                Background="{StaticResource AccentBrush}"
                                Click="CancelExit_Click"/>
                        <Button Grid.Column="2" Content="Confirm Exit"
                                Background="{StaticResource HighlightBrush}"
                                IsEnabled="{Binding ExitInputEnabled}"
                                Click="ConfirmExit_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ Exam complete overlay ══════════════════════════════════════════ -->
        <Grid x:Name="CompleteOverlay" Grid.RowSpan="6" Panel.ZIndex="200"
              Visibility="Collapsed">
            <Rectangle Fill="#CC000000"/>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                    Padding="40" Width="480" VerticalAlignment="Center"
                    BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="✓ Exam Complete" FontSize="22" FontWeight="Bold"
                               Foreground="#6eff6e" Margin="0,0,0,16"/>
                    <TextBlock x:Name="CompleteStudentText"
                               FontSize="14" Margin="0,0,0,8"/>
                    <TextBlock x:Name="CompleteExamText"
                               FontSize="13" Foreground="{StaticResource SecondaryBrush}"
                               Margin="0,0,0,16"/>
                    <TextBlock Text="Files saved to your Desktop:"
                               FontSize="12" Foreground="{StaticResource SecondaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="CompleteRtfPath"
                               FontSize="11" Foreground="#a0d0ff"
                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock x:Name="CompleteLogPath"
                               FontSize="11" Foreground="#a0d0ff"
                               TextWrapping="Wrap" Margin="0,0,0,24"/>
                    <Button Content="Close Application"
                            Background="{StaticResource HighlightBrush}"
                            Height="42" FontSize="14"
                            Click="CloseApp_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
