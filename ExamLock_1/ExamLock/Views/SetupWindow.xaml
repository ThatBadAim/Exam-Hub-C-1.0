<Window x:Class="ExamLock.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ExamLock.ViewModels"
        Title="ExamLock — Setup"
        Width="520" Height="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        ResizeMode="NoResize">

    <Window.DataContext>
        <vm:SetupViewModel/>
    </Window.DataContext>

    <Grid Margin="40,32,40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,28">
            <TextBlock Text="ExamLock" FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource HighlightBrush}" FontFamily="Segoe UI"/>
            <TextBlock Text="Secure Examination System" FontSize="13"
                       Foreground="{StaticResource SecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Error banner -->
        <Border Grid.Row="1" Background="#5e1a2e" CornerRadius="6" Padding="12,8"
                Margin="0,0,0,16"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#ff6b8a" TextWrapping="Wrap"/>
        </Border>

        <!-- Form fields -->
        <StackPanel Grid.Row="2" x:Name="FormPanel">

            <!-- Exam Board -->
            <TextBlock Text="Exam Board" Margin="0,0,0,4" FontSize="12"
                       Foreground="{StaticResource SecondaryBrush}"/>
            <TextBox Text="{Binding ExamBoard, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,14"/>

            <!-- Exam Name -->
            <TextBlock Text="Exam Name" Margin="0,0,0,4" FontSize="12"
                       Foreground="{StaticResource SecondaryBrush}"/>
            <TextBox Text="{Binding ExamName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,14"/>

            <!-- Student Full Name -->
            <TextBlock Text="Student Full Name" Margin="0,0,0,4" FontSize="12"
                       Foreground="{StaticResource SecondaryBrush}"/>
            <TextBox Text="{Binding StudentFullName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,14"/>

            <!-- Student Number + Centre Number side by side -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Student Number" Margin="0,0,0,4" FontSize="12"
                               Foreground="{StaticResource SecondaryBrush}"/>
                    <TextBox Text="{Binding StudentNumber, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Centre Number" Margin="0,0,0,4" FontSize="12"
                               Foreground="{StaticResource SecondaryBrush}"/>
                    <TextBox Text="{Binding CentreNumber, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <!-- Timed exam toggle + duration -->
            <CheckBox Content="Timed Exam" IsChecked="{Binding IsTimedExam}"
                      Margin="0,0,0,10"/>
            <StackPanel Visibility="{Binding TimerFieldVisible, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,0,14">
                <TextBlock Text="Duration (minutes)" Margin="0,0,0,4" FontSize="12"
                           Foreground="{StaticResource SecondaryBrush}"/>
                <TextBox Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                         Width="120" HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- Invigilator password -->
            <TextBlock Text="Invigilator Password (min 4 characters)" Margin="0,0,0,4" FontSize="12"
                       Foreground="{StaticResource SecondaryBrush}"/>
            <PasswordBox x:Name="PasswordBox1" Margin="0,0,0,14"
                         PasswordChanged="PasswordBox1_PasswordChanged"/>

            <TextBlock Text="Confirm Invigilator Password" Margin="0,0,0,4" FontSize="12"
                       Foreground="{StaticResource SecondaryBrush}"/>
            <PasswordBox x:Name="PasswordBox2" Margin="0,0,0,20"
                         PasswordChanged="PasswordBox2_PasswordChanged"/>
        </StackPanel>

        <!-- Start button -->
        <Button Grid.Row="3" Content="Start Exam →"
                Command="{Binding StartExamCommand}"
                Height="44" FontSize="15" FontWeight="SemiBold"/>
    </Grid>
</Window>
